# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DEBUG=false
# Set to true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
# Optional: absolute SQLite path, or a SQLAlchemy URL for another database.
# DATABASE_URL=sqlite:////absolute/path/to/data.db
# Optional Google integrations; leave empty to disable.
# reCAPTCHA is always disabled when DEBUG=true.
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_CSE_ID=
